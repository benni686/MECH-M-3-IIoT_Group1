  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Aktuelle Werte",
      "description": "Letzter Messwert je Sensor im gewählten Zeitraum, mit Verlauf.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "iiot-sqlite"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "iiot-sqlite"
          },
          "queryType": "time series",
          "rawQueryText": "SELECT CAST(strftime('%s', measured_at) AS INTEGER) AS time, sensor_type, AVG(value) AS value\nFROM readings\nWHERE group_name = '$group'\n  AND sensor_type IN (${sensor:sqlstring})\n  AND CAST(strftime('%s', measured_at) AS INTEGER) >= $__from / 1000 AND CAST(strftime('%s', measured_at) AS INTEGER) < $__to / 1000\nGROUP BY 1, 2\nORDER BY 1",
          "queryText": "SELECT CAST(strftime('%s', measured_at) AS INTEGER) AS time, sensor_type, AVG(value) AS value\nFROM readings\nWHERE group_name = '$group'\n  AND sensor_type IN (${sensor:sqlstring})\n  AND CAST(strftime('%s', measured_at) AS INTEGER) >= $__from / 1000 AND CAST(strftime('%s', measured_at) AS INTEGER) < $__to / 1000\nGROUP BY 1, 2\nORDER BY 1",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.sensor_type}",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*temperatur.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(humid|hygro|feucht).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gerätestatus",
      "description": "Letzte Meldung auf iiot/group/<gruppe>/status (ok, error, offline).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "iiot-sqlite"
