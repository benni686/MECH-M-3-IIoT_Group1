        "h": 6,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "iiot-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT status\nFROM device_status\nWHERE group_name = '$group'",
          "queryText": "SELECT status\nFROM device_status\nWHERE group_name = '$group'",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unbekannt",
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "text": "ok",
                  "color": "green",
                  "index": 0
                },
                "error": {
                  "text": "error",
                  "color": "red",
                  "index": 1
                },
                "offline": {
                  "text": "offline",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^status$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
